# Copy to .env and fill in real values. NEVER commit the real .env.
# Every key the scripts read from the environment should be listed here with a
# blank or placeholder value — this file is the contract for "what config does
# this toolkit need to run".

# --- Target & scope ---
# The server this toolkit is allowed to harden. A safety guard: scripts should
# refuse to run unless the operator confirms this is the intended host.
TARGET_HOSTNAME=
PRIMARY_DOMAIN=
ADMIN_EMAIL=

# --- SSH hardening ---
# Port to move sshd to (default 22 is heavily scanned). Non-privileged user that
# keeps SSH access after root login is disabled.
SSH_PORT=22
SSH_ALLOW_USER=

# --- Firewall (UFW) ---
# Extra TCP ports to open beyond SSH/HTTP/HTTPS, comma-separated.
UFW_EXTRA_TCP_PORTS=

# --- MySQL / MariaDB ---
# Used only by scripts that create/secure the DB. Prefer a secrets store or
# interactive prompt over putting real passwords here.
DB_ROOT_PASSWORD=
DB_APP_USER=
DB_APP_PASSWORD=
DB_APP_NAME=

# --- fail2ban / alerting ---
FAIL2BAN_DEST_EMAIL=

# --- Let's Encrypt / TLS ---
LETSENCRYPT_EMAIL=
